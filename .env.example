# 웹 화면(python3 bootstrap.py)에서 연결하면 이 파일은 필요 없습니다.
# cron/작업 스케줄러로 창 없이 돌릴 때만 쓰세요. 실제 값이 들어가므로 절대 공유하지 마세요.

# --- 로그인: 아래 둘 중 한 가지만 채우세요 ---

# (1) 모든 학교 — 학교 LMS 주소 + Canvas 액세스 토큰
#     토큰은 LMS의 계정 → 설정 → 승인된 통합 → "+ 새 액세스 토큰"에서 발급합니다.
LMS_BASE_URL=
LMS_ACCESS_TOKEN=

# (2) 한동대 — 학번 + 히즈넷 비밀번호
HGU_ID=
HGU_PASSWORD=

# --- 텔레그램 ---

# BotFather 에게 /newbot 으로 발급받은 값. 토큰은 남과 공유하지 말고 각자 만드세요.
TELEGRAM_BOT_TOKEN=

# 본인의 chat_id. 웹 화면의 "봇에게 메시지 보낸 뒤 chat_id 확인" 버튼으로 알아낼 수 있습니다.
TELEGRAM_CHAT_ID=

# 며칠치를 가져올지 (기본 7)
DAYS_AHEAD=7
